+/* Global for JNI access to the live GPIO state. Set on realize. */
+static Esp32GpioState *g_gpio_state = NULL;
+
+int esp32_gpio_get_output_level(int pin)
+{
+    Esp32GpioState *s = g_gpio_state;
+    if (!s || pin < 0 || pin >= 32) {
+        return -1;
+    }
+    if (!(s->gpio_enable & (1u << pin))) {
+        return -1; /* not configured as output */
+    }
+    return (s->gpio_out >> pin) & 1;
+}
+
+/* qdev input handler: called when an external source drives a GPIO input line.
+ * Updates the GPIO_IN register state that guest firmware reads. */
+static void esp32_gpio_input_handler(void *opaque, int pin, int level)
+{
+    Esp32GpioState *s = ESP32_GPIO(opaque);
+    if (pin < 0 || pin >= 32) {
+        return;
+    }
+    if (level) {
+        s->gpio_in |= (1u << pin);
+    } else {
+        s->gpio_in &= ~(1u << pin);
+    }
+}
+
+/* Injects an external input level via QEMU's qdev GPIO input mechanism.
+ * Gets the pin's input IRQ and drives it, which triggers the input handler
+ * and updates GPIO_IN. This is how host-side (Android) input reaches the
+ * emulated peripheral. */
+void esp32_gpio_inject_input(int pin, int level)
+{
+    Esp32GpioState *s = g_gpio_state;
+    if (!s || pin < 0 || pin >= ESP32_GPIO_PIN_COUNT) {
+        return;
+    }
+    qemu_irq irq = qdev_get_gpio_in(DEVICE(s), pin);
+    qemu_set_irq(irq, level ? 1 : 0);
+}
+
+static void esp32_gpio_update_pin(Esp32GpioState *s, int pin)
+{
+    if (pin < 0 || pin >= ESP32_GPIO_PIN_COUNT) {
+        return;
+    }
+    int level = 0;
+    if (pin < 32 && (s->gpio_enable & (1u << pin))) {
+        level = (s->gpio_out >> pin) & 1;
+    }
+    qemu_set_irq(s->gpio_out_irq[pin], level);
+}
+
 static void esp32_gpio_write(void *opaque, hwaddr addr,
                        uint64_t value, unsigned int size)
 {
+    Esp32GpioState *s = ESP32_GPIO(opaque);
+    uint32_t v = (uint32_t)value;
+    uint32_t changed;
+    int pin;
+
+    switch (addr) {
+    case A_GPIO_OUT:
+        changed = s->gpio_out ^ v;
+        s->gpio_out = v;
+        for (pin = 0; pin < 32; pin++) {
+            if (changed & (1u << pin)) {
+                esp32_gpio_update_pin(s, pin);
+            }
+        }
+        break;
+    case A_GPIO_OUT_W1TS:
+        changed = (~s->gpio_out) & v;
+        s->gpio_out |= v;
+        for (pin = 0; pin < 32; pin++) {
+            if (changed & (1u << pin)) {
+                esp32_gpio_update_pin(s, pin);
+            }
+        }
+        break;
+    case A_GPIO_OUT_W1TC:
+        changed = s->gpio_out & v;
+        s->gpio_out &= ~v;
+        for (pin = 0; pin < 32; pin++) {
+            if (changed & (1u << pin)) {
+                esp32_gpio_update_pin(s, pin);
+            }
+        }
+        break;
+    case A_GPIO_ENABLE:
+        s->gpio_enable = v;
+        for (pin = 0; pin < 32; pin++) {
+            esp32_gpio_update_pin(s, pin);
+        }
+        break;
+    case A_GPIO_ENABLE_W1TS:
+        s->gpio_enable |= v;
+        for (pin = 0; pin < 32; pin++) {
+            if (v & (1u << pin)) {
+                esp32_gpio_update_pin(s, pin);
+            }
+        }
+        break;
+    case A_GPIO_ENABLE_W1TC:
+        s->gpio_enable &= ~v;
+        for (pin = 0; pin < 32; pin++) {
+            if (v & (1u << pin)) {
+                esp32_gpio_update_pin(s, pin);
+            }
+        }
+        break;
+    default:
+        break;
+    }
 }
 
